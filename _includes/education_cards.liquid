<div class="education-section">
  <h2>Education</h2>
  <div class="education-cards">
    {% for item in site.data.education.education %}
      <a class="edu-card" href="{{ item.url }}" target="_blank" rel="noopener">
        {% if item.image %}
          <img class="edu-card-img" src="{{ item.image }}" alt="{{ item.institution }} logo" />
        {% endif %}
        <div class="edu-card-content">
          <div class="edu-card-title">{{ item.title }}</div>
          <div class="edu-card-inst">{{ item.institution }}</div>
          <div class="edu-card-year">{{ item.year }}</div>
        </div>
      </a>
    {% endfor %}
  </div>
  <hr class="edu-separator" />
  <h2>Credentials</h2>
  <div class="education-cards">
    {% for item in site.data.education.credentials %}
      <a class="edu-card" href="{{ item.url }}" target="_blank" rel="noopener">
        {% if item.image %}
          <img class="edu-card-img" src="{{ item.image }}" alt="{{ item.institution }} logo" />
        {% endif %}
        <div class="edu-card-content">
          <div class="edu-card-title">{{ item.title }}</div>
          <div class="edu-card-inst">{{ item.institution }}</div>
          <div class="edu-card-year">{{ item.year }}</div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>
