<div class="container my-5">
  <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
    {% for area in include.areas %}
    <div class="col-12 col-md-4 d-flex mb-4 px-3 px-lg-4">
      <div class="flip-card flex-fill">
        <div class="flip-card-inner">
          <div class="flip-card-front d-flex align-items-center justify-content-center p-3">
            <h5 class="card-title text-center">{{ area.front }}</h5>
          </div>
          <div class="flip-card-back d-flex align-items-center justify-content-center p-3">
            <p class="card-text text-center">{{ area.back }}</p>
          </div>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>
<div class="caption">
  Interactive cards detailing research areas relevant to the Gawain project.
</div>
